<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All users</title>
    <style>
        table,th,td {
            border : 1px solid black;
        }
    </style>
</head>
<body>
    
    <table>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
        </tr>

        <!-- <tr>
            <td>123</td>
            <td>john_doe</td>
            <td>john@example.com</td>
        </tr> -->

        <% for (user of users) { %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.username %></td>
            <td>
            <form method="GET" action="/user/<%=user.id%>/edit">
                <button>Edit username</button>
            </td>

            </form>
        </tr>
        <% } %>
    </table>

</body>
</html>


